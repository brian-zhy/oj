# ---- Database ----
# Local dev needs NO .env file: the app defaults to a local SQLite file
# (sqlite+aiosqlite:///./oj.db). Copy this file to .env and set DATABASE_URL
# below only when you want to target PostgreSQL (e.g. production). When ENV=prod,
# a SQLite URL is rejected at startup.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oj_service

# ---- Auth ----
# Leave JWT_SECRET empty in dev: a random per-process secret is auto-generated
# (tokens invalidate on each restart — fine, even helpful, in dev).
# It MUST be set explicitly when ENV=prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Runtime ----
# dev | prod   (prod requires JWT_SECRET and a PostgreSQL DATABASE_URL)
ENV=dev

# ---- Email Service ----
# SMTP配置（支持QQ邮箱、163邮箱、Gmail等）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_EMAIL=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Jason227
