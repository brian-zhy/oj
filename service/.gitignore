# Python-generated files
__pycache__/
.pytest_cache
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local env / secrets
.env

# Local SQLite database
*.db
*.db-journal
oj.db

# Production config (keep .env.production.example if created)
.env.production

# Logs
logs/
*.log

# Runtime files
*.pid
*.sock

# Static uploads
static/uploads/*

# Editor backup files
*~
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Debug/test output（指根目录下的手工调试脚本，如 test_login_api.py）
debug_*.py
test_*.py
check_*.py
fix_*.py
show_*.py

# 上面的 test_*.py 是全局模式，会误伤正式的测试套件；
# tests/ 目录下的测试必须能正常提交。
!tests/test_*.py